# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Réservation en ligne ---------------------------------------------------
# Sans ces deux variables, le site utilise en développement un stockage local
# (.data/booking.json) et, en production, retombe sur la réservation via les
# réseaux sociaux. Créez le schéma avec supabase/schema.sql avant de les définir.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Espace administration --------------------------------------------------
# Obligatoire pour accéder à /admin.
ADMIN_PASSWORD=
# Optionnel : sinon la clé de session est dérivée de ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# --- Emails automatiques (optionnel) ---------------------------------------
# Sans fournisseur, les messages sont enregistrés avec le statut "skipped".
RESEND_API_KEY=
NOTIFICATION_FROM="Beauty Ley <rendezvous@votre-domaine.com>"

# --- Rappels automatiques (optionnel) --------------------------------------
# Jeton attendu par /api/cron/reminders (en-tête Authorization: Bearer ...).
CRON_SECRET=

# --- Alertes équipe (téléphone) --------------------------------------------
# ntfy : chaque membre installe l'app ntfy et s'abonne au sujet.
NTFY_TOPIC=
# Optionnel, défaut https://ntfy.sh
NTFY_SERVER=
# Telegram (optionnel) : bot + groupe du staff.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paiement en ligne (optionnel, non activé) -----------------------------
# Tant que ces clés sont absentes, seul le paiement sur place est proposé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
